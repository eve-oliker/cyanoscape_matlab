% Organize processed sb files - organize each by station for data type
% Eve Oliker
% 08/03/2026
clear;
clc;

%% 1: set directory, target folders, site/station mapping
% folder to find final sb output
sbFolder = '/folder/directory/';

% target subfolders to process (files by station, not site)
dataTypes = {'TRIOS', 'SE', 'GER', 'ACS'};

% identify site names and station mapping
siteNames = {'Rietvlei', 'Klein_River_Estuary', 'Theewaterskloof', 'Zeekoevlei'};
stationsPerSite = {...
    {'RV1A', 'RV1B', 'RV1C', 'RV1D', 'RV1E', 'RV2A', 'RV2B', 'RV2C', 'RV2D', 'RV2E', 'RV3A', 'RV3B', 'RV3C'},...
    {'KR1A', 'KR1B', 'KR1C', 'KR1D', 'KR1E'},...
    {'TW1A', 'TW2A', 'TW2B', 'TW2C', 'TW3A', 'TW3C', 'TW3E', 'TW3F', 'TW4A'}, ...
    {'ZK1A', 'ZK1B', 'ZK1C', 'ZK1D', 'ZK1E', 'ZK2A', 'ZK2B', 'ZK2C', 'ZK2D', 'ZK2E', 'ZK3A', 'ZK3B', 'ZK3C', 'ZK3D', 'ZK3E'}...
    };

%% 2: loop through each data type folder (TRIOS, SE, GER, ACS)
for d = 1:length(dataTypes)
    dataType = dataTypes{d};
    % search for subfolders that match the data type (e.g. "ACS")
    dirType = dir(fullfile(sbFolder, ['*' dataType '*']));
    dirType = dirType([dirType.isdir] & ~ismember({dirType.name}, {'.', '..'}));
    if isempty(dirType)
        fprintf('Folder for %s not found in %s, skipping...\n', dataType, sbFolder);
        continue;
    end
    
    for t = 1:length(dirType)
        currentTypeFolder = fullfile(sbFolder, dirType(t).name);
        fprintf('processing %s\n', dirType(t).name);
        % get all files in this data folder
        files = dir(fullfile(currentTypeFolder, '*.*'));
        files = files(~[files.isdir]); 
        
        for s = 1:length(siteNames)
            currentSite = siteNames{s};
            currentStations = stationsPerSite{s};
            siteDestination = fullfile(currentTypeFolder, currentSite);       	% create destination folder inside the current data type folder

            % loop through files in current folder
            for f = 1:length(files)
                fileName = files(f).name;
                
                if any(contains(fileName, currentStations, 'IgnoreCase', true))  % check if filename contains any station code for this site
                    
                    % create destination folder if it doesn't exist
                    if ~exist(siteDestination, 'dir')
                        mkdir(siteDestination);
                    end
                    
                    % move file to site subfolder
                    sourceFile = fullfile(currentTypeFolder, fileName);
                    destinationFile = fullfile(siteDestination, fileName);
      
                    movefile(sourceFile, destinationFile);
                    fprintf('Moved %s to %s/\n', fileName, currentSite);
                end
            end
        end
    end
end
