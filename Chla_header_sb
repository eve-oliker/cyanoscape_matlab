%% Chlorophyll A Data Processing (Site & SeaBASS)
% By Eve Oliker
% Created on 06/22/2026

clear; clc;

% Set the folder where the file resides
inputFolder = '/input/folder/location';
inputFile = 'input_file_name.csv';
ogTablePath = fullfile(inputFolder, inputFile);
ogTable = readtable(ogTablePath);

metaPath = '/path/to/metadata';
metadataTable = readtable(fullfile(metaPath, 'BIOSCAPE_metadataTable.xlsx'));
metadataTable.Properties.VariableNames = lower(metadataTable.Properties.VariableNames);

%% Identify sites and stations
% Identify sites and the correlated file names to create/ that were created
siteNames = {'Rietvlei', 'Klein_River_Estuary', 'Theewaterskloof', 'Zeekoevlei'};
fileNames = {'Rietvlei_Chl_A_SeaBASS.xlsx', 'Klein_River_Estuary_Chl_A_SeaBASS.xlsx', 'Theewaterskloof_Chl_A_SeaBASS.xlsx', 'Zeekoevlei_Chl_A_SeaBASS.xlsx'};

% Identify which stations correlate to each site defined above
stationsPerSite = {...
    {'RV1A', 'RV1B', 'RV1C', 'RV1D', 'RV1E', 'RV2A', 'RV2B', 'RV2C', 'RV2D', 'RV2E', 'RV3A', 'RV3B', 'RV3C'},...
    {'KR1A', 'KR1B', 'KR1C', 'KR1D', 'KR1E'},...
    {'TW1A', 'TW2A', 'TW2B', 'TW2C', 'TW3A', 'TW3C', 'TW3E', 'TW3F'}, ...
    {'ZK1A', 'ZK1B', 'ZK1C', 'ZK1D', 'ZK1E', 'ZK2A', 'ZK2B', 'ZK2C', 'ZK2D', 'ZK2E', 'ZK3A', 'ZK3B', 'ZK3C', 'ZK3D', 'ZK3E'}...
    };

%% Loop - split data into new file by site
for s = 1:length(siteNames)
    currentSite = siteNames{s};
    currentFile = fileNames{s};
    currentStationList = stationsPerSite{s}; 
    
    % Filter rows belonging to the stations for this site
    dataStations = upper(strip(string(ogTable.Station)));  % make sure it matches regardless of uppercase/ lowercase
    targetStations = upper(strip(string(currentStationList))); 
    siteRowsMask = ismember(dataStations, targetStations);
    siteTable = ogTable(siteRowsMask, :);
    siteTable.Properties.VariableNames = lower(siteTable.Properties.VariableNames);
    
    if ismember('chla', siteTable.Properties.VariableNames)
        siteTable.Properties.VariableNames{strcmp(siteTable.Properties.VariableNames, 'chla')} = 'chl_a';
    end

    if ~ismember('secchi_depth', siteTable.Properties.VariableNames)
        siteTable.secchi_depth = nan(height(siteTable), 1);
    end
   
    for i = 1:length(currentStationList)
        currentStation = currentStationList{i};
        metaRow = strcmpi(metadataTable.station, currentStation);
        dataRows = strcmpi(siteTable.station, currentStation);
        if any(metaRow)
            siteTable.secchi_depth(dataRows) = metadataTable.secchi_depth(metaRow);
        end
    end

    fieldsList = {'date', 'station', 'lat', 'lon', 'SZ', 'volfilt', 'chl_a'};
    unitsList = {'yyyymmdd', 'none', 'degrees', 'degrees', 'm', 'l', 'mg/m^3'};
    dataType = 'pigment';
    projectDocuments = 'TBD';

    siteTable.secchi_depth(isnan(siteTable.secchi_depth)) = -9999;     % fill missing secchi depth with missing value -9999
    siteTable.SZ = siteTable.secchi_depth;     % replace with seabass SZ

    siteTable = siteTable(:, fieldsList);

    %% add water and weather notes
    siteComments = {};
    stationsInFile = unique(strip(string(siteTable.station)));     % create mapping table - column name and header title

    for noteType = ["weather_notes", "water_surface_notes"]
        if ismember(noteType, metadataTable.Properties.VariableNames)
            subTable = metadataTable(ismember(metadataTable.station, stationsInFile), ["station", noteType]);
            subTable = subTable(~ismissing(subTable.(noteType)) & subTable.(noteType) ~= "" & subTable.(noteType) ~= "NA", :);

            [G, uniqueNotes] = findgroups(subTable.(noteType));
            for g = 1:max(G)
                stns = strjoin(subTable.station(G == g), '; ');
                % set header label
                if noteType == "weather_notes"
                    label = "Weather Notes";
                else
                    label = "Water Surface Notes";
                end
                % assemble final string, apend to siteComments
                siteComments{end+1, 1} = sprintf('! %s [%s]: %s', label, char(stns), char(uniqueNotes(g)));
            end
        end
    end

    %% Call the header function
    project_info = Seabass_project_headers(currentSite, currentStationList, fieldsList, unitsList);
    headerStartDate = project_info.start_date;

    % make the field for /data_file_name match the ultimate sb output file
    sbFileName = sprintf('BIOSCAPE-CHL_A-%s-%s-%s-R1.sb', ...
        currentSite, dataType, char(headerStartDate));

    project_info.data_file_name = sbFileName;
    project_info.data_type = dataType;
    project_info.documents = projectDocuments;
    fields = fieldnames(project_info); % extracts a list of the text labels as an array of strings
    headerCellArray = {}; % builds sequentially by row
  
    %% start the header
    headerCellArray{end+1, 1} = '/begin_header';
    for f = 1:length(fields)     % translation loop that moves through metadata fields
        fieldName = fields{f};
        val = project_info.(fields{f});
            if isnumeric(val)
                if isempty(val)
                    val = ''; % deal with empty numeric arrays
                else
                    val = num2str(val);
                end
            end
        val = char(val); %make sure val is a char vector
        headerCellArray{end+1,1} = sprintf('/%s=%s', fieldName, val);
    end

%% insert comments
comments = {...
    '! Sample water was filtered through Whatman GF/F filters (0.7 µm nominal pore size; 25 mm diameter) for analysis', ...
    '! The volume filtered varied depending on the productivity of the sample site but was sufficient so that pigment color was observed on the filter (10 or 30 mL).', ...
    '! Sample filters were stored in 8 mL of 90% acetone at -18 °C prior to analysis.', ...
    '! Chla was analyzed on a Turner Designs Trilogy Laboratory Fluorometer using the non-acidification method (Welschmeyer 1994).', ...
    '! Chla concentration was determined from the measured Relative Fluorescence Units (RFU) using a calibration curve specific to the instrument.', ...
    };

    allComments = [comments(:); siteComments(:)];

    idx = find(contains(headerCellArray, '/fields='));     % insert the comments above the fields line
    headerCellArray = [headerCellArray(1:idx-1); allComments(:); headerCellArray(idx:end)];
    headerCellArray{end+1, 1} = '/end_header';     % add end header line

    %% Save directly to Excel files
    outputFile = fullfile(inputFolder, currentFile);
     if exist(outputFile, 'file')
         delete(outputFile);
     end

    %% Write the metadata cells starting at row 1
    writecell(headerCellArray(:), outputFile, 'FileType', 'spreadsheet', 'Range', 'A1');
    % Write the numerical data rows below the header
    writetable(siteTable, outputFile, 'FileType', 'spreadsheet', 'WriteMode', 'append', 'WriteVariableNames', false);
    fprintf('Saved: %s\n\n', outputFile);

    %% Call the file post-processing function for this site
    headerStartDate = project_info.start_date;
    convert_excel_to_seabass(inputFolder, dataType, currentSite, headerStartDate);
end
